# 仅用于本地开发；请复制为 .env 并自行设置强随机密钥。
APP_ENV=development
DATABASE_URL=postgresql+psycopg://smartorder:change_me@localhost:5432/smartorder
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-valid-fernet-key
CORS_ORIGINS=http://localhost:5173
PRINT_AGENT_URL=http://127.0.0.1:17321
PRINT_AGENT_TOKEN=replace-with-local-agent-token
VITE_API_URL=http://127.0.0.1:8000/api/v1
VITE_PRINT_AGENT_URL=http://127.0.0.1:17321/api/v1
VITE_PRINT_AGENT_TOKEN=replace-with-local-agent-token

